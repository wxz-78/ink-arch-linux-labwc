# Ink — swaylock. Lienzo negro liso (sin imagen: no hay nada que pueda fallar).
daemonize
ignore-empty-password
show-failed-attempts

color=0a0a0a
font=JetBrainsMono Nerd Font
font-size=22

indicator-idle-visible
indicator-radius=90
indicator-thickness=6

inside-color=0a0a0aff
ring-color=ffffff30
line-color=00000000
separator-color=00000000
text-color=e8e8e8

key-hl-color=ffffff
bs-hl-color=6e6e6e
inside-ver-color=0a0a0aff
ring-ver-color=ffffff90
text-ver-color=e8e8e8

