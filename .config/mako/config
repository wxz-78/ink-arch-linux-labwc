# Ink — mako. Notificaciones estilo tarjeta macOS.
font=JetBrainsMono Nerd Font 11
format=<b>%s</b>\n%b
width=360
height=150
margin=60,16,10
padding=16,18
border-size=1
border-radius=18
max-visible=4
max-history=30
icons=1
max-icon-size=42
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor
default-timeout=6000
layer=overlay
anchor=top-right
group-by=app-name

on-button-left=invoke-default-action
on-button-middle=dismiss-all
on-button-right=dismiss

background-color=#141414f0
text-color=#f5f5f5
border-color=#ffffff1f
progress-color=over #ffffff33

[urgency=low]
text-color=#bfbfbf
default-timeout=3000

# Urgentes: invertidas con sutil brillo
[urgency=high]
background-color=#f5f5f5f2
text-color=#101010
border-color=#ffffff
progress-color=over #1010101f
default-timeout=0

# Barra de volumen/brillo (script osd)
# OJO con border-radius: debe ser MENOR que la mitad de la altura real de la tarjeta (~50 px con este padding).
# Con valores enormes (p. ej. 999) mako dibuja arcos gigantes que se cruzan y se ve una «X» deforme ocupando la pantalla.
[category=osd]
format=%s
anchor=bottom-center
margin=0,0,90,0
width=300
height=84
padding=14,24
default-timeout=1200
group-by=category
border-radius=20
background-color=#141414ee
text-color=#f5f5f5
border-color=#ffffff1f

[mode=dnd]
invisible=1
